// Alloy — слушател за syslog на 127.0.0.1:601 (RFC 5424 по TCP) на тази машина.
// Пращат: стековете през драйвера syslog на Docker (tag "{{.Name}}") и rsyslog на хоста.
// Етикетът app = името на програмата (sshd, kernel…) или на контейнера.
// HOST и LOKI_URL идват от средата.

loki.source.syslog "docker" {
  listener {
    address                = "127.0.0.1:601"
    protocol               = "tcp"
    syslog_format          = "rfc5424"
    use_incoming_timestamp = true
    labels                 = { host = sys.env("HOST"), source = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.central.receiver]
}

loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
